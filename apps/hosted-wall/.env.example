# Random 32+ byte secret used to sign the access cookie.
GATE_SECRET=
# The party access code people type at citations.hosaka.xyz.
GATE_ACCESS_CODE=
# Shared workspace. Publishable key only — never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_WORKSPACE_ID=
# Recommended: dedicated reader account email & password (never rotates on use).
SUPABASE_READER_EMAIL=
SUPABASE_READER_PASSWORD=
# Optional fallback refresh token if email/password are not set.
SUPABASE_REFRESH_TOKEN=
# Change alongside a fresh dedicated reader login to bypass stale cached sessions.
SUPABASE_SESSION_VERSION=v1
